<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="my_payment_account_link" inherit_id="portal.my_account_link">
        <xpath expr="//a[@href='/my/home']" position="after">
            <a href="/my/payment-account" role="menuitem" class="dropdown-item ps-3">
                <i
                    class="fa fa-fw fa-credit-card me-1 small text-muted"
                /> My Payment Account
            </a>
        </xpath>
    </template>

    <template
        id="portal_my_home_invoice_custom_url"
        inherit_id="account.portal_my_home_invoice"
        name="Show Payment Account"
        priority="10"
    >
        <xpath
            expr="//t[@t-set='title' and normalize-space(text())='Invoices &amp; Bills']/following-sibling::t[@t-set='url']"
            position="attributes"
        >
            <attribute name="t-value">'/my/payment-account'</attribute>
        </xpath>
    </template>
</odoo>
